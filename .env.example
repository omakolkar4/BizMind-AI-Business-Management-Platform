# Database configuration
# For local SQLite: file:./dev.db
# For PostgreSQL: postgresql://user:password@localhost:5432/bizmind?schema=public
DATABASE_URL="file:./dev.db"

# Authentication secret (Generate using: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# AI Configuration
# When AI_MODE=demo, the platform uses deterministic, highly realistic AI agent multi-agent simulation.
# When AI_MODE=live, provide an OpenAI-compatible API key.
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_MODE="demo"
